# ==========================================
# CAGE (Cake Gestão) - Variáveis de Ambiente
# ==========================================

# Ambiente de Execução do ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# Configurações do Banco de Dados PostgreSQL 16
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cakegestao_db
DB_USER=postgres
DB_PASSWORD=insira_sua_senha_aqui

# Configurações de Segurança e JWT
JWT_SECRET_KEY=insira_uma_chave_secreta_segura_de_no_minimo_32_caracteres
JWT_ISSUER=CakeGestaoAPI
JWT_AUDIENCE=CakeGestaoApp
JWT_EXPIRATION_HOURS=8

# Configurações de Logging
LOG_LEVEL_DEFAULT=Information