# CAGE — variáveis consumidas pelo docker-compose.yml.
# Copie para .env e substitua os valores locais. Não versione credenciais reais.
# O dotnet run não carrega este arquivo automaticamente; consulte o README.

ASPNETCORE_ENVIRONMENT=Development
ROTA_DO_FRONTEND=http://localhost:4200

POSTGRES_DB=cakegestao_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUBSTITUA_POR_SUA_SENHA_LOCAL

JWT_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_BYTES
JWT_ISSUER=CakeGestaoAPI
JWT_AUDIENCE=CakeGestaoApp
# Access token em minutos; refresh token em dias.
JWT_ACCESS_EXPIRATION=30
JWT_REFRESH_EXPIRATION=7
